{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "ucrt-debug",
            "displayName": "MSYS2 UCRT64 Debug",
            "description": "Build Assignment 5 with the MSYS2 UCRT64 compiler and Ninja.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-ucrt",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
                "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
                "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "environment": {
                "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ucrt-debug",
            "configurePreset": "ucrt-debug"
        }
    ]
}
