{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Assignment5：渲染 binary.ppm（完成 TODO 后）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Assignment5/Assignment5_code/build-ucrt/RayTracing.exe",
            "args": [],
            "cwd": "${workspaceFolder}/Assignment5/Assignment5_code/build-ucrt",
            "preLaunchTask": "Assignment5: Build",
            "environment": [{"name": "PATH", "value": "C:/msys64/ucrt64/bin;${env:PATH}"}],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
        },
        {
            "name": "Assignment4：交互绘制 Bezier 曲线",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Assignment4/Assignment4_code/build-ucrt/BezierCurve.exe",
            "args": [],
            "cwd": "${workspaceFolder}/Assignment4/Assignment4_code/build-ucrt",
            "preLaunchTask": "Assignment4: Build",
            "environment": [{"name": "PATH", "value": "C:/msys64/ucrt64/bin;${env:PATH}"}],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
        },
        {
            "name": "Assignment3：环境检查（算法未完成时使用）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Assignment3/Assignment3_code/build-ucrt/Rasterizer.exe",
            "args": ["--check-environment"],
            "cwd": "${workspaceFolder}/Assignment3/Assignment3_code/build-ucrt",
            "preLaunchTask": "Assignment3: Build",
            "environment": [{"name": "PATH", "value": "C:/msys64/ucrt64/bin;${env:PATH}"}],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
        },
        {
            "name": "Assignment3：选择着色器并保存图片",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Assignment3/Assignment3_code/build-ucrt/Rasterizer.exe",
            "args": ["${input:assignment3OutputFile}", "${input:assignment3Shader}"],
            "cwd": "${workspaceFolder}/Assignment3/Assignment3_code/build-ucrt",
            "preLaunchTask": "Assignment3: Build",
            "environment": [{"name": "PATH", "value": "C:/msys64/ucrt64/bin;${env:PATH}"}],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
        },
        {
            "name": "当前 CMake 目标：无参数",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${command:cmake.launchTargetDirectory}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "启用 GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Assignment1：指定角度和输出文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "-r",
                "${input:rotationAngle}",
                "${input:outputFile}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Assignment1/code",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "启用 GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Assignment2：保存结果图片",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "${input:assignment2OutputFile}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Assignment2/Assignment2_code",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "启用 GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "assignment3Shader",
            "type": "pickString",
            "description": "选择 Assignment3 着色器（需先实现相应算法）",
            "options": ["normal", "phong", "texture", "bump", "displacement"],
            "default": "normal"
        },
        {
            "id": "assignment3OutputFile",
            "type": "promptString",
            "description": "图片文件名（默认保存在 build-ucrt）",
            "default": "output.png"
        },
        {
            "id": "rotationAngle",
            "type": "promptString",
            "description": "请输入旋转角度",
            "default": "20"
        },
        {
            "id": "outputFile",
            "type": "promptString",
            "description": "请输入输出文件名",
            "default": "image.png"
        },
        {
            "id": "assignment2OutputFile",
            "type": "promptString",
            "description": "请输入 Assignment 2 输出文件名",
            "default": "output.png"
        }
    ]
}
