{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Rasterizer (UCRT64)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/code/build-ucrt/Rasterizer.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/code",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build Rasterizer"
        }
    ]
}
